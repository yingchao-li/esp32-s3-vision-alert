{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32: Build",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/build.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ESP32: Flash",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/flash.sh", "${input:espPort}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ESP32: Serial Monitor",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/monitor.sh", "${input:espPort}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ],
  "inputs": [
    {
      "id": "espPort",
      "type": "promptString",
      "description": "ESP32 serial port (close other Serial Monitors first)",
      "default": "/dev/cu.usbmodem5C930528211"
    }
  ]
}
